# Postgres (used by docker-compose and the backend)
# Host port 5434 so it doesn't clash with a Postgres already running on 5432.
POSTGRES_USER=games
POSTGRES_PASSWORD=games
POSTGRES_DB=games
POSTGRES_PORT=5434
DATABASE_URL=postgresql://games:games@localhost:5434/games

# Backend
BACKEND_PORT=8000
# Optional Web Push VAPID keys (auto-generated and stored in Postgres if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_SUB=mailto:games@jakob-r.de

# Frontend dev server (Vite proxies /api and /ws to the backend on BACKEND_PORT)
FRONTEND_PORT=5173

# Production behind an existing nginx-proxy + acme-companion (see ARCHITECTURE.md "VPS deployment")
# VIRTUAL_HOST=games.jakob-r.de
# LETSENCRYPT_HOST=games.jakob-r.de
# LETSENCRYPT_EMAIL=you@example.com
# PROXY_NETWORK=docker_compose_proxy-tier
# PROXY_HTML_VOLUME=docker_compose_html
# Localhost-only debug port of the app container
# APP_PORT=8082
