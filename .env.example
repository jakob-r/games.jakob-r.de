# Postgres (used by docker-compose and the backend)
# Host port 5434 so it doesn't clash with a Postgres already running on 5432.
POSTGRES_USER=games
POSTGRES_PASSWORD=games
POSTGRES_DB=games
POSTGRES_PORT=5434
DATABASE_URL=postgresql://games:games@localhost:5434/games

# Backend
BACKEND_PORT=8000
# Optional Web Push VAPID keys (auto-generated and stored in Postgres if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_SUB=mailto:games@jakob-r.de

# Accounts
# Public origin, used for email links and the Google OAuth callback ({base}/api/auth/oauth/google/callback).
# In production use https://games.jakob-r.de (this also enables Secure cookies).
PUBLIC_BASE_URL=http://localhost:5173
# Signs OAuth flow cookies; auto-generated and stored in Postgres if omitted.
# AUTH_SECRET=
# console = log emails to the backend output (dev); smtp = really send them.
AUTH_MAIL_BACKEND=console
# AUTH_MAIL_FROM=games@jakob-r.de
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Google sign-in (optional; the button is hidden when empty). Create a Web OAuth client and add
# http://localhost:5173/api/auth/oauth/google/callback (and the production URL) as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend dev server (Vite proxies /api and /ws to the backend on BACKEND_PORT)
FRONTEND_PORT=5173

# Production behind an existing nginx-proxy + acme-companion (see ARCHITECTURE.md "VPS deployment")
# VIRTUAL_HOST=games.jakob-r.de
# LETSENCRYPT_HOST=games.jakob-r.de
# LETSENCRYPT_EMAIL=you@example.com
# PROXY_NETWORK=docker_compose_proxy-tier
# PROXY_HTML_VOLUME=docker_compose_html
# Localhost-only debug port of the app container
# APP_PORT=8082
